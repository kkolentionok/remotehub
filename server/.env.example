# Copy to `.env` and fill in. docker-compose reads it automatically.

# REQUIRED: secret for signing JWT bearer tokens. Use a long random string,
# e.g.  openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# Optional overrides (defaults shown):
# BIND_ADDR=0.0.0.0:8080
# DB_PATH=/data/sync.db
# TOKEN_TTL_HOURS=168
# MAX_BLOB_BYTES=5242880
# RUST_LOG=info

# --- Slice 3a-2: Yandex OAuth + email verification ---
# OAuth is enabled only when PUBLIC_BASE_URL + both YANDEX_* are set.
# PUBLIC_BASE_URL is the externally-reachable origin (used to build the Yandex
# redirect_uri and verification links). Must be HTTPS in production.
# PUBLIC_BASE_URL=https://pingie.ru
# YANDEX_CLIENT_ID=
# YANDEX_CLIENT_SECRET=
# Register the app at https://oauth.yandex.com/client/new with
#   Redirect URI: https://pingie.ru/v1/oauth/yandex/callback
#   Scopes: login:email, login:info
#
# Require email verification before password login (default off):
# REQUIRE_EMAIL_VERIFICATION=false
# (SMTP delivery is not built in yet — the verification link is logged.)
