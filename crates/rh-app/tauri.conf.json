{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "RemoteHub",
    "version": "0.1.0",
    "identifier": "app.remotehub.desktop",
    "build": {
        "beforeDevCommand": {
            "script": "pnpm dev",
            "cwd": "../../ui"
        },
        "beforeBuildCommand": {
            "script": "pnpm build",
            "cwd": "../../ui"
        },
        "devUrl": "http://localhost:1420",
        "frontendDist": "../../ui/dist"
    },
    "app": {
        "withGlobalTauri": true,
        "windows": [
            {
                "title": "RemoteHub",
                "width": 1280,
                "height": 800,
                "minWidth": 800,
                "minHeight": 500,
                "resizable": true,
                "fullscreen": false,
                "decorations": true
            }
        ],
        "security": {
            "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:"
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "category": "DeveloperTool",
        "shortDescription": "Cross-platform SSH and RDP client",
        "longDescription": "RemoteHub is a unified SSH and RDP client with a modern UI and OS-native credential storage."
    }
}
